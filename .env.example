# ContextIQ Environment Configuration
# Copy this file to .env in the project root and adjust values as needed.
# The backend reads these at startup via os.getenv().

# ── Ollama / LLM ─────────────────────────────────────────────────────────────
LLM_MODEL_NAME=llama3.2:3b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT=120

# ── Embedding & Reranking Models ──────────────────────────────────────────────
# Both models are cached locally in ~/.cache/huggingface/hub
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2

# ── Retrieval Settings ────────────────────────────────────────────────────────
# Number of final chunks returned after reranking
DEFAULT_TOP_K=3
# Number of candidate chunks retrieved from ChromaDB before reranking
DEFAULT_CANDIDATE_K=10

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Summarization ─────────────────────────────────────────────────────────────
# LLM temperature (0.0 = deterministic, 0.7 = creative)
LLM_TEMPERATURE=0.3
# Max chunks to include per document in summarization (prevents memory overload)
MAX_CHUNKS_PER_DOC_SUMMARY=12

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Relative to project root
CHROMA_DB_PATH=data/vector_db
CHROMA_COLLECTION_NAME=document_chunks

# ── Data Paths ────────────────────────────────────────────────────────────────
RAW_DOCS_PATH=data/raw
PROCESSED_DOCS_PATH=data/processed
CHUNKS_PATH=data/chunks
METADATA_PATH=data/documents_metadata.json
HISTORY_PATH=data/history.json
